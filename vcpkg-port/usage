getopt-win provides CMake targets:

  # Static linking
  find_package(getopt REQUIRED)
  target_compile_definitions(main PRIVATE STATIC_GETOPT)
  target_link_libraries(main PRIVATE getopt::getopt_static)

  # Shared linking
  find_package(getopt REQUIRED)
  target_link_libraries(main PRIVATE getopt::getopt_shared)

  # Unicode support
  target_compile_definitions(main PRIVATE _UNICODE)